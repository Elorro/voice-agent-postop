# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  LO ÚNICO QUE HAY QUE TOCAR PARA ARRANCAR:                                ║
# ║                                                                           ║
# ║    1. LLM_API_KEY   -> cree la suya: https://aistudio.google.com/apikey   ║
# ║    2. STT_API_KEY   -> cree la suya: https://console.groq.com/keys        ║
# ║    3. LLM_MODELO    -> ya viene puesto; cámbielo solo si ve HTTP 429      ║
# ║                                                                           ║
# ║  Nada más de este archivo hay que tocarlo.                                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
#   Linux/macOS:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#
# Rutas siempre RELATIVAS a la raíz del repositorio (`scripts/sin_rutas_absolutas.sh`).
# Por qué cada decisión: docs/DECLARACION_MODELO.md y docs/calibracion_rag.md.


# --- LLM: perfil A (ACTIVO), Gemini ------------------------------------------
# Cuota del nivel gratuito: 20 peticiones/día POR MODELO. Si ve HTTP 429, cambie
# LLM_MODELO por el siguiente de la lista de docs/DECLARACION_MODELO.md §5.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODELO=models/gemini-3.6-flash
LLM_PERFIL=remoto
LLM_API_KEY=aqui_la_api_key_del_llm_(gemini)
EXTRACTOR_TIMEOUT_MS=2500
REDACTOR_TIMEOUT_MS=2000
# `reasoning_effort` que se manda. VACÍO = no se manda el campo. El valor válido
# depende del modelo: 3.6-flash exige `low`, 3.5-flash acepta `none`, y los
# modelos locales lo RECHAZAN con 400. Tabla: docs/DECLARACION_MODELO.md §5.
LLM_RAZONAMIENTO=low

# --- LLM: perfil B (alterna), Llama 3.1 70B remoto ---------------------------
# Modelo literal de la lista permitida. Requiere saldo en el proveedor.
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODELO=meta-llama/llama-3.1-70b-instruct
#   LLM_PERFIL=remoto
#   LLM_API_KEY=aqui_la_api_key_del_llm_(openrouter)
#   EXTRACTOR_TIMEOUT_MS=2500
#   REDACTOR_TIMEOUT_MS=600
#   LLM_RAZONAMIENTO=

# --- LLM: perfil C (fallback), Llama 3.2 local -------------------------------
# Sin clave, sin cuota y sin red. Levántelo con: docker compose --profile local up -d
# Los timeouts largos NO son opcionales aquí (ver docs/DECLARACION_MODELO.md §4).
#
# `LLM_RAZONAMIENTO=` VACÍA tampoco es opcional, y es la línea que rompió este
# perfil entero: Ollama responde
#   HTTP 400 {"error":{"message":"\"llama3.2:3b\" does not support thinking"}}
# ante `reasoning_effort: low`, que es lo que necesita el perfil A. Con la
# variable vacía el campo no se envía y el modelo local responde 200.
#   LLM_BASE_URL=http://llm-local:11434/v1
#   LLM_MODELO=llama3.2:3b
#   LLM_PERFIL=local
#   LLM_API_KEY=
#   EXTRACTOR_TIMEOUT_MS=20000
#   REDACTOR_TIMEOUT_MS=8000
#   RAG_TIMEOUT_MS=30000
#   LLM_RAZONAMIENTO=


# --- STT: Groq (whisper-large-v3) --------------------------------------------
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODELO=whisper-large-v3
STT_API_KEY=aqui_la_api_key_de_groq_(whisper)
STT_IDIOMA=es
STT_TIMEOUT_S=12


# --- Servidor y montajes ------------------------------------------------------
# PUERTO es el del HOST; dentro del contenedor el proceso escucha en 8080.
PUERTO=8080
DATASET_DIR=./dataset
INDICE_BASE_DIR=./indice_base
LOGS_HOST_DIR=./datos/logs
LLAMADAS_HOST_DIR=./datos/llamadas


# --- Turno de voz -------------------------------------------------------------
# 0 apaga el redactor: el agente habla siempre por plantilla.
REDACTOR_ACTIVO=1
LLM_MAX_TOKENS=220
MAX_TURNOS_LLAMADA=12
# Turnos SEGUIDOS que el agente no logra procesar (fallo del STT o del LLM)
# antes de cerrar con FALLO_DE_INFRAESTRUCTURA. Es la condición de parada: sin
# ella, un proveedor caído deja la llamada repitiendo la misma pregunta hasta
# MAX_TURNOS_LLAMADA. Por qué 3: docs/bitacora.md F3.9.
MAX_TURNOS_SIN_PROCESAR=3


# --- Reintento ante HTTP 429 --------------------------------------------------
# LLM_ESPERA_429_MS es el tope de espera de TODA una invocación, no de cada una.
LLM_MAX_INTENTOS=3
LLM_ESPERA_429_MS=2000
LLM_BACKOFF_BASE_MS=250

# `LLM_RAZONAMIENTO` YA NO ESTÁ AQUÍ, y borrarlo de este sitio fue el arreglo.
# Vive DENTRO de cada bloque de perfil, como `EXTRACTOR_TIMEOUT_MS` desde F3.4 y
# por la misma razón, esta vez medida: con la variable en dos sitios del archivo
# gana la ÚLTIMA asignación —verificado con `docker run --env-file`—, así que el
# `LLM_RAZONAMIENTO=` del bloque C quedaba pisado por el `=low` de aquí abajo y
# el perfil local arrancaba roto sin que nada lo dijera.


# --- Extractor: rango de plausibilidad de una temperatura dicha --------------
# NO es un umbral clínico; esos viven solo en politica/parametros.py.
FIEBRE_MIN_C=30
FIEBRE_MAX_C=45


# --- RAG ----------------------------------------------------------------------
# El RAG NO clasifica: la clase clínica sale de politica.decidir y ninguna de
# estas variables puede moverla (tests/test_rag_no_altera_clase.py).
# Por qué cada número: docs/calibracion_rag.md.
RAG_ACTIVO=1
RAG_K=5
# Umbral de suficiencia: por debajo, el agente declara su límite en vez de improvisar.
RAG_UMBRAL=0.59
# Peso del canal denso al fundirlo con el léxico.
RAG_ALFA=0.5
RAG_POOL=60
# Cambiar el troceo obliga a REINDEXAR: el índice que viaja se construyó con estos.
RAG_TROZO_CARACTERES=600
RAG_SOLAPE_CARACTERES=150
RAG_MAX_TEXTO_CITADO=400
RAG_TIMEOUT_MS=4000
RAG_MAX_TOKENS=200
SUBIDOS_MAX_MB=25


# --- Detección de fin de habla, en el navegador -------------------------------
# Cómo ajustarlos: README §5.0.1.
VAD_UMBRAL_RMS=0.02
VAD_SILENCIO_MS=700
VAD_MINIMO_HABLA_MS=300


# --- Verificación de estado ---------------------------------------------------
SALUD_TIMEOUT_S=6
SALUD_CACHE_S=10
# 0 para no salir a la red al comprobar LLM y STT (demo offline).
SALUD_COMPROBAR_RED=1
# Inferencia real de comprobación: listar un modelo NO es servirlo. Con
# `arranque` se hace UNA vez por proceso (y se reintenta mientras falle);
# `siempre` en cada sondeo; `0` nunca. Por qué existe: docs/bitacora.md F3.9.
SALUD_INFERENCIA=arranque
# 10 s, no los 6 de SALUD_TIMEOUT_S: en el perfil C la primera inferencia carga
# el modelo en memoria.
SALUD_INFERENCIA_TIMEOUT_MS=10000
NIVEL_LOG=INFO


# --- Fijadas en compose.yaml y en la imagen, no aquí --------------------------
# DIR_APP, DIRECCION_BIND, INDICE_DIR, SUBIDOS_DIR, LOGS_DIR, LLAMADAS_DIR,
# INDICE_SEMILLA_DIR, VOCES_DIR, VOZ_MODELO.
