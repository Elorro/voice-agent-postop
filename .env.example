# Copie este archivo a `.env` y pegue las DOS claves: `LLM_API_KEY` y
# `STT_API_KEY`. Son dos servicios distintos. `.env` está en .gitignore y nunca
# se sube al repositorio.
#
#   Linux/macOS:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#
# Toda ruta de este archivo es RELATIVA a la raíz del repositorio. No escriba
# rutas absolutas aquí: este archivo se lee en la máquina del jurado, donde
# nada está donde está aquí. `scripts/sin_rutas_absolutas.sh` lo verifica.


# --- Obligatorio: LLM (modelo de lenguaje) ------------------------------------
#
# LEA ESTO ANTES DE TOCAR NADA:  docs/DECLARACION_MODELO.md
#
# El modelo de lenguaje NO se sirve desde Groq, y no es una preferencia: los
# modelos de la lista permitida del reto que Groq y Google servían fueron
# retirados por sus proveedores. Tabla de deprecaciones consultada el
# 2026-08-09: https://console.groq.com/docs/deprecations
# El modelo exigido (Llama 3.1 70B) se conserva; lo que cambia es quién lo
# sirve, que el reto declara parte libre del stack.
#
# El STT sí sigue en Groq y tiene su propio bloque más abajo: son dos servicios
# distintos, con dos claves distintas.

# --- Perfil A (ACTIVO): Llama 3.1 70B remoto, endpoint OpenAI-compatible ------
# Identificador exacto del modelo, tal como lo sirve el proveedor. Verificado
# con:  curl -s https://openrouter.ai/api/v1/models | grep llama-3.1-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODELO=meta-llama/llama-3.1-70b-instruct
LLM_PERFIL=remoto
# Clave del proveedor. Sin ella el agente arranca pero no puede razonar, y
# /salud lo reporta como NO LISTO.
# Para la evaluación: la clave viene en el informe final; NO está en el repo.
LLM_API_KEY=

# --- Perfil C (FALLBACK): Llama 3.2 local, sin salir a internet ---------------
# Celda «Local, CPU» de la misma lista permitida. Mismo protocolo que el perfil
# A: solo cambia el base_url, no hay un segundo cliente. Para usarlo, comente
# las cuatro líneas de arriba y descomente estas cuatro:
#
#   LLM_BASE_URL=http://llm-local:11434/v1
#   LLM_MODELO=llama3.2:3b
#   LLM_PERFIL=local
#   LLM_API_KEY=
#
# y levante el perfil:  docker compose --profile local up -d
# (`llama3.2:1b` si la máquina va justa de RAM. Contra un llama.cpp/Ollama que
# ya tenga corriendo en el host, use LLM_BASE_URL=http://host.docker.internal:11434/v1)


# --- Servidor ----------------------------------------------------------------

# Puerto del HOST. Dentro del contenedor el proceso escucha siempre en 8080;
# compose mapea PUERTO -> 8080. Cámbielo solo si 8080 ya está ocupado.
PUERTO=8080


# --- Orígenes de los montajes (host) ------------------------------------------
# Son el lado HOST de los binds declarados en compose.yaml. Si el directorio no
# existe, Docker lo crea vacío y el servicio arranca igual.

# Corpus y datos del reto (montado :ro).
DATASET_DIR=./dataset

# Semilla del índice vectorial, si existe (montada :ro). Hoy está vacía: el
# indexador todavía no existe y el índice arranca con 0 documentos.
INDICE_BASE_DIR=./indice_base

# Logs en texto plano, legibles sin `docker cp`.
LOGS_HOST_DIR=./datos/logs


# --- Obligatorio: STT (transcripción de voz) ----------------------------------
# Servicio distinto del LLM y NO afectado por lo anterior: la compuerta G3 del
# reto restringe el modelo de LENGUAJE, no el de transcripción, y
# `whisper-large-v3` sigue servido por Groq — no aparece en la tabla de
# deprecaciones consultada el 2026-08-09.
#
# Contingencia (fuera del cronómetro): cree una clave propia en
# console.groq.com; el plan gratuito basta para la demostración.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODELO=whisper-large-v3
STT_API_KEY=


# --- Verificación de estado ---------------------------------------------------

# Segundos de espera al comprobar que cada proveedor es alcanzable.
SALUD_TIMEOUT_S=6

# Segundos que /salud memoiza su informe. Evita una llamada de red por recarga.
SALUD_CACHE_S=10

# 0 para no salir a la red al comprobar LLM y STT (red restringida, demo
# offline). Con 0, /salud los reporta como AVISO en vez de verificarlos: no
# comprueba que el modelo exista, solo que está configurado.
SALUD_COMPROBAR_RED=1

# DEBUG | INFO | WARNING | ERROR
NIVEL_LOG=INFO


# --- Fijadas en compose.yaml, no aquí -----------------------------------------
# Estas son rutas INTERNAS del contenedor y tienen que coincidir con los
# destinos de los montajes, así que compose.yaml las fija y .env no las toca:
#
#   DIR_APP=/app  DIRECCION_BIND=0.0.0.0  INDICE_DIR=./datos/indice
#   SUBIDOS_DIR=./datos/subidos  LOGS_DIR=./datos/logs
#   INDICE_SEMILLA_DIR=/opt/indice_base
#
# Y estas las fija la imagen (ver Dockerfile), porque apuntan a modelos
# vendorizados en tiempo de build:
#
#   VOCES_DIR=/opt/voces  VOZ_MODELO=es_MX-ald-medium.onnx
